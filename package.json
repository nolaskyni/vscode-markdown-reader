{
  "name": "markdown-reader",
  "displayName": "Markdown Reader",
  "version": "0.0.0",
  "private": true,
  "description": "Styles the Markdown preview and notebook Markdown cells for comfortable reading.",
  "categories": [
    "Other"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nolaskyni/vscode-markdown-reader.git"
  },
  "publisher": "nolaskyni",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node scripts/build.ts",
    "check-types": "tsc",
    "format": "oxfmt",
    "lint": "oxlint --type-aware",
    "lint:css": "stylelint '**/*.css'",
    "lint:markdown": "markdownlint-cli2 '**/*.md'",
    "test:unit": "vitest run src/ scripts/",
    "test:vscode": "npm run build && vscode-test",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@mdit/plugin-alert": "2.2.0",
    "@mdit/plugin-footnote": "1.2.0",
    "@mdit/plugin-tasklist": "1.3.0",
    "@primer/octicons": "19.42.0",
    "@types/mocha": "10.0.10",
    "@types/node": "26.6.6",
    "@types/vscode": "1.146.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "markdown-it": "15.0.3",
    "markdownlint-cli2": "0.24.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "postcss-html": "2.0.1",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "stylelint-order": "8.1.3",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./media/preview.css"
    ]
  },
  "activationEvents": [],
  "engines": {
    "vscode": "^1.146.0"
  }
}
